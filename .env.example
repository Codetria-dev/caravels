# Caravels — Configuration
#
# News is fetched from multiple providers with automatic fallback:
#   1. GNews (best quality) — requires GNEWS_API_KEY
#   2. RSS feeds (free, always works) — no key needed
#   3. NewsAPI — requires NEWS_API_KEY
#
# At least one provider is recommended; RSS works without any keys.

# GNews — https://gnews.io/
# Free tier: 100 requests/day, 10 articles/request
GNEWS_API_KEY=your_gnews_key_here

# NewsAPI — https://newsapi.org/
# Free tier: 100 requests/day, developer use only
NEWS_API_KEY=your_newsapi_key_here

# Supabase — https://supabase.com/
# Used for authentication (Google OAuth + email) and user data sync.
# Create a free project at supabase.com, then copy the values from
# Project Settings > API.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
