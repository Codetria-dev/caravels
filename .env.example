# Caravels — Frontend (Vercel)
#
# Copy this file to .env and fill in your values.

# VITE_API_URL — Your Railway backend URL (only needed in production)
# In dev, the Vite proxy forwards /api/* to localhost:3000 by default.
# Set this to your deployed backend URL in the Vercel dashboard.
VITE_API_URL=http://localhost:3000

# Supabase — Authentication & user data
# Get these from supabase.com > Project Settings > API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
